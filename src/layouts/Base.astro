---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	// 共有時の画像（og:image）。省略時はサイト共通の画像
	image?: string;
	// 前日譚のページ：「今年」の強調（珊瑚）を出さない
	calm?: boolean;
	// 検索の対象から外す（サイトマップからは astro.config.mjs で外す）
	noindex?: boolean;
}
const { title, description, image, calm = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} image={image} noindex={noindex} />
		<slot name="head" />
	</head>
	<body>
		<Header calm={calm} />
		<slot />
		<Footer />
	</body>
</html>
