---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import KeyNumbers from '../components/KeyNumbers.astro';
import PrequelBridge from '../components/PrequelBridge.astro';
import SourcesBox from '../components/SourcesBox.astro';
import { CURRENT_YEAR, TOTAL_YEARS } from '../consts';
import PostList from '../components/PostList.astro';
import PrNotice from '../components/PrNotice.astro';
import ProfileBox from '../components/ProfileBox.astro';
import SeriesNav from '../components/SeriesNav.astro';
import ShareX from '../components/ShareX.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import { partLabel } from '../data/categories';
import { ogPath, readingMinutes } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	prev?: CollectionEntry<'posts'>;
	next?: CollectionEntry<'posts'>;
	headings: MarkdownHeading[];
	related: CollectionEntry<'posts'>[];
}
const { post, prev, next, headings, related } = Astro.props;
const { title, description, updatedDate, category, tags, pr, summary, keyNumbers, sources, asOf } =
	post.data;
// 何年目に書いたか：月次は frontmatter の year、それ以外は固定値 CURRENT_YEAR
const year = (category === 'monthly' && post.data.year) || CURRENT_YEAR;
// 前日譚のページでは「今年」の強調（珊瑚）を出さない
const calm = category === 'prequel';
const image = ogPath(post);
---

<Base title={title} description={description} image={image} calm={calm}>
	<div class="post-layout">
		<main class="prose">
			<article class="sheet">
				<p class="post-meta" style={`--cat: var(--c-${category})`}>
					<a class="part" href={`/category/${category}/`}>{partLabel(category)}</a>
					<span>{readingMinutes(post)}分で読めます</span>
				</p>
				<h1>{title}</h1>
				<p class:list={['year-badge', { calm }]}>
					<span class:list={['yr-cells', { calm }]} aria-hidden="true">
						{Array.from({ length: TOTAL_YEARS }, (_, i) => (
							<i class:list={[{ done: !calm && i + 1 < year, now: !calm && i + 1 === year }]}>{i + 1}</i>
						))}
					</span>
					{calm ? <><b>設立前</b>・法人を作る前の話です</> : <>この記事は{TOTAL_YEARS}年のうち<b>{year}年目</b>に書きました</>}
				</p>
				{pr && <PrNotice />}
				{
					summary && (
						<section class="summary" aria-label="この記事の結論">
							<p class="summary-title"><span>CONCLUSION</span>この記事の結論</p>
							<p class="summary-body">{summary}</p>
						</section>
					)
				}
				{keyNumbers && keyNumbers.length > 0 && <KeyNumbers items={keyNumbers} />}
				<Toc headings={headings} />
				<slot />
				{
					tags.length > 0 && (
						<p class="tags">
							{tags.map((t) => (
								<a href={`/tags/${t}/`}>#{t}</a>
							))}
						</p>
					)
				}
				<p class="disclaimer">
					この記事は筆者1人の体験（n=1）です。制度や金額は執筆時点のもので、税務の判断は税理士に、体調の判断は医師にご相談ください。
				</p>
				<SourcesBox sources={sources} asOf={asOf} updatedDate={updatedDate} />
			</article>
			<div class="post-end">
				<ProfileBox />
				{category !== 'monthly' && <SeriesNav prev={prev} next={next} category={category} />}
				{calm && <PrequelBridge last={!next} />}
				{
					related.length > 0 && (
						<section class="related">
							<p class="related-title">関連記事</p>
							<PostList posts={related} cols={3} />
						</section>
					)
				}
				<ShareX title={title} />
			</div>
		</main>
		<Sidebar />
	</div>
</Base>

<style>
	.post-layout {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.25rem 0.5rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 3rem;
	}
	/* スマホは紙を広く使う。紙の外（記事末・サイドバー）だけ左右に余白 */
	.post-end,
	.post-layout :global(.sidebar) {
		padding-inline: 0.5rem;
	}
	@media (min-width: 700px) {
		.post-layout {
			padding: 2rem 1rem;
		}
		.post-end,
		.post-layout :global(.sidebar) {
			padding-inline: 0;
		}
	}
	@media (min-width: 1100px) {
		.post-layout {
			grid-template-columns: minmax(0, var(--measure)) 270px;
			justify-content: center;
		}
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.6rem;
		font-size: 0.85rem;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	.post-meta .part {
		color: var(--cat, var(--accent));
		font-weight: 700;
		letter-spacing: 0.06em;
		text-decoration: none;
		border: 1px solid var(--cat, var(--accent));
		border-radius: 999px;
		padding: 0 0.7rem;
	}
	/* 6年の年表の小型版（マスは global.css の .yr-cells） */
	.year-badge {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.2rem 0.6rem;
		margin: -0.5rem 0 2rem;
		padding: 0 0 1.1rem;
		font-size: 0.88rem;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
	}
	.year-badge :global(.yr-cells i) {
		width: 24px;
		height: 26px;
		font-size: 12px;
		line-height: 24px;
	}
	.year-badge b {
		color: var(--deadline-ink);
	}
	.year-badge.calm b {
		color: var(--accent);
	}
	h1 {
		font-size: clamp(1.55rem, 5.2vw, 2.1rem);
		line-height: 1.5;
		margin: 0.4rem 0 1.1rem;
	}
	/* 結論ボックス：薄い面＋左の深緑線。見出しは小さなラベル */
	.summary {
		border-left: 4px solid var(--accent);
		border-radius: 0 8px 8px 0;
		margin: 0 0 2rem;
		padding: 1rem 1.25rem 1.1rem;
		background: var(--accent-soft);
	}
	.summary-title {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		margin: 0 0 0.45rem;
		font-size: 0.82rem;
		letter-spacing: 0.08em;
		color: var(--accent-strong);
		font-weight: 700;
	}
	.summary-title span {
		font-family: var(--mincho);
		font-size: 0.95rem;
		letter-spacing: 0.18em;
		opacity: 0.8;
	}
	.summary-body {
		margin: 0;
		font-weight: 500;
		font-size: 1.05rem;
		line-height: 1.9;
		white-space: pre-line;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.85rem;
		margin-top: 2rem;
	}
	.tags a {
		text-decoration: none;
		background: var(--subtle);
		border-radius: 999px;
		padding: 0.1rem 0.8rem;
	}
	.disclaimer {
		font-size: 0.8rem;
		color: var(--muted);
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		margin-top: 2rem;
	}
	.post-end {
		margin-top: 2.5rem;
	}
	.related {
		margin-top: 2.5rem;
	}
	.related-title {
		font-weight: 700;
		font-size: 1.1rem;
		margin: 0 0 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--line);
		display: block;
	}
</style>
