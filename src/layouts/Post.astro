---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import KeyNumbers from '../components/KeyNumbers.astro';
import PrequelBridge from '../components/PrequelBridge.astro';
import SourcesBox from '../components/SourcesBox.astro';
import { CURRENT_YEAR, TOTAL_YEARS } from '../consts';
import PostList from '../components/PostList.astro';
import PrNotice from '../components/PrNotice.astro';
import ProfileBox from '../components/ProfileBox.astro';
import SeriesNav from '../components/SeriesNav.astro';
import ShareX from '../components/ShareX.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import { partLabel } from '../data/categories';
import { ogPath, readingMinutes } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: CollectionEntry<'posts'>;
	prev?: CollectionEntry<'posts'>;
	next?: CollectionEntry<'posts'>;
	headings: MarkdownHeading[];
	related: CollectionEntry<'posts'>[];
}
const { post, prev, next, headings, related } = Astro.props;
const { title, description, updatedDate, category, tags, pr, summary, keyNumbers, sources, asOf } =
	post.data;
// 何年目に書いたか：月次は frontmatter の year、それ以外は固定値 CURRENT_YEAR
const year = (category === 'monthly' && post.data.year) || CURRENT_YEAR;
// 前日譚のページには朱を出さない
const calm = category === 'prequel';
const image = ogPath(post);
---

<Base title={title} description={description} image={image} calm={calm}>
	<div class="post-layout">
		<main class="prose">
			<article>
				<p class="post-meta">
					<a class="part" href={`/category/${category}/`}>{partLabel(category)}</a>
					<span>{readingMinutes(post)}分で読めます</span>
				</p>
				<h1>{title}</h1>
				<p class:list={['year-badge', { calm }]}>
					<span class="cells" aria-hidden="true">
						{Array.from({ length: TOTAL_YEARS }, (_, i) => (
							<i class:list={[{ done: i + 1 < year, now: i + 1 === year }]} />
						))}
					</span>
					この記事は{TOTAL_YEARS}年のうち<b>{year}年目</b>に書きました
				</p>
				<img class="eyecatch" src={image} alt="" width="1200" height="630" />
				{pr && <PrNotice />}
				{
					summary && (
						<section class="summary" aria-label="この記事の結論">
							<p class="summary-title">この記事の結論</p>
							<p class="summary-body">{summary}</p>
						</section>
					)
				}
				{keyNumbers && keyNumbers.length > 0 && <KeyNumbers items={keyNumbers} />}
				<Toc headings={headings} />
				<slot />
				{
					tags.length > 0 && (
						<p class="tags">
							{tags.map((t) => (
								<a href={`/tags/${t}/`}>#{t}</a>
							))}
						</p>
					)
				}
				<p class="disclaimer">
					この記事は筆者1人の体験（n=1）です。制度や金額は執筆時点のもので、税務の判断は税理士に、体調の判断は医師にご相談ください。
				</p>
				<SourcesBox sources={sources} asOf={asOf} updatedDate={updatedDate} />
			</article>
			<div class="post-end">
				<ProfileBox />
				{category !== 'monthly' && <SeriesNav prev={prev} next={next} category={category} />}
				{calm && <PrequelBridge last={!next} />}
				{
					related.length > 0 && (
						<section class="related">
							<p class="related-title">関連記事</p>
							<PostList posts={related} cols={3} />
						</section>
					)
				}
				<ShareX title={title} />
			</div>
		</main>
		<Sidebar />
	</div>
</Base>

<style>
	.post-layout {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.5rem 1rem;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 3rem;
	}
	@media (min-width: 1100px) {
		.post-layout {
			grid-template-columns: minmax(0, var(--measure)) 270px;
			justify-content: center;
		}
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.6rem;
		font-size: 0.85rem;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	.post-meta .part {
		color: #fff;
		background: var(--accent);
		border-radius: 999px;
		padding: 0 0.7rem;
		font-weight: 700;
		text-decoration: none;
	}
	.year-badge {
		--now: var(--deadline);
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: -0.5rem 0 1rem;
		padding: 0.2rem 0.75rem;
		font-size: 0.82rem;
		color: var(--muted);
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 999px;
	}
	.year-badge.calm {
		--now: var(--accent);
	}
	.year-badge b {
		color: var(--now);
	}
	.year-badge .cells {
		display: inline-grid;
		grid-template-columns: repeat(6, 6px);
		gap: 2px;
	}
	.year-badge i {
		display: block;
		height: 11px;
		border: 1.5px solid var(--muted);
		opacity: 0.55;
	}
	.year-badge i.done {
		background: var(--text);
		border-color: var(--text);
		opacity: 1;
	}
	.year-badge i.now {
		background: var(--now);
		border-color: var(--now);
		opacity: 1;
	}
	h1 {
		font-size: clamp(1.45rem, 4.8vw, 1.85rem);
	}
	.eyecatch {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 10px;
		border: 1px solid var(--line);
		margin: 0 0 1.5rem;
	}
	.summary {
		border: 2px solid var(--accent);
		border-radius: 10px;
		margin: 0 0 1.75rem;
		overflow: hidden;
	}
	.summary-title {
		margin: 0;
		padding: 0.4rem 1rem;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
	}
	.summary-body {
		margin: 0;
		padding: 0.85rem 1.1rem;
		background: var(--accent-soft);
		font-weight: 700;
		line-height: 1.8;
		white-space: pre-line;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.85rem;
		margin-top: 2rem;
	}
	.tags a {
		text-decoration: none;
		background: var(--subtle);
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.1rem 0.7rem;
	}
	.disclaimer {
		font-size: 0.8rem;
		color: var(--muted);
		border-top: 1px solid var(--line);
		padding-top: 1rem;
		margin-top: 2rem;
	}
	.post-end {
		margin-top: 2.5rem;
	}
	.related {
		margin-top: 2.5rem;
	}
	.related-title {
		font-weight: 700;
		font-size: 1.1rem;
		margin: 0 0 1rem;
		padding-left: 0.7rem;
		border-left: 5px solid var(--accent);
	}
</style>
