---
import { SITE_TITLE } from '../consts';
import SixYearScale from './SixYearScale.astro';

// calm: 前日譚のページでは「今年」の強調（珊瑚）を出さない
const { calm = false } = Astro.props;

const links = [
	{ href: '/hajimeni/', label: 'はじめに' },
	{ href: '/series/', label: '連載目次' },
	{ href: '/category/monthly/', label: '月次収支' },
	{ href: '/services/', label: '使ったサービス' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="inner">
		<div class="brand">
			<a class="site-title mincho" href="/"><img src="/favicon.svg" alt="" aria-hidden="true" width="28" height="28" />{SITE_TITLE}</a>
			<a class="gauge" href="/hajimeni/"><SixYearScale size="mini" calm={calm} /></a>
		</div>
		<nav aria-label="メイン">
			{
				links.map((l) => (
					<a href={l.href} class={path.startsWith(l.href) ? 'active' : undefined}>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-top: 4px solid var(--accent);
		border-bottom: 1px solid var(--line);
		background: var(--card);
	}
	.inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 0.75rem 1rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
	}
	.brand {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 1rem;
		min-width: 0;
	}
	.gauge {
		text-decoration: none;
	}
	.site-title {
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: 0.04em;
		color: var(--text);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.site-title img {
		display: block;
		height: 28px;
		width: 28px;
	}
	nav {
		display: flex;
		gap: 1rem;
		min-width: 0;
		max-width: 100%;
		overflow-x: auto;
		white-space: nowrap;
		font-size: 0.95rem;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		padding: 0.25rem 0;
		border-bottom: 2px solid transparent;
	}
	nav a:hover,
	nav a.active {
		color: var(--text);
		border-bottom-color: var(--deadline);
	}
</style>
