---
// 強調ボックスの共通部品。Point / Caution / Memo から使う
// point／caution／memo とも、淡い面＋左に3pxの線（深緑／珊瑚の文字色／黄土）
interface Props {
	kind: 'point' | 'caution' | 'memo';
	title: string;
}
const { kind, title } = Astro.props;
const icon = { point: '✓', caution: '!', memo: '✎' }[kind];
---

<aside class:list={['box', kind]}>
	<p class="box-title"><span class="icon" aria-hidden="true">{icon}</span>{title}</p>
	<div class="box-body"><slot /></div>
</aside>

<style>
	.box {
		position: relative;
		margin: 2rem 0 1.75rem;
		padding: 1rem 1.2rem 1.05rem;
		border-radius: 0 6px 6px 0;
		background: var(--bgc);
		color: var(--text);
	}
	.point {
		--c: var(--accent);
		--on-c: var(--bg);
		--bgc: var(--accent-soft);
		border-left: 3px solid var(--accent);
	}
	.caution {
		--c: var(--warn);
		--on-c: var(--bg);
		--bgc: var(--warn-soft);
		border-left: 3px solid var(--warn);
	}
	.memo {
		--c: var(--memo);
		--on-c: var(--bg);
		--bgc: var(--memo-soft);
		border-left: 3px solid var(--memo);
	}
	.box-title {
		margin: 0 0 0.5rem !important;
		font-weight: 700;
		font-size: 0.95rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.icon {
		flex: none;
		display: inline-grid;
		place-items: center;
		width: 1.5em;
		height: 1.5em;
		border-radius: 50%;
		background: var(--c);
		color: var(--on-c);
		font-size: 0.85em;
	}
	.box-body :global(> :last-child) {
		margin-bottom: 0;
	}
</style>
