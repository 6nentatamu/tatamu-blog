---
// 横棒グラフ（インラインSVG）。色は CSS 変数なのでダークモードでも読める
//   <BarChart data={[{ label: '任意継続', value: 44.2, note: '最長2年ほぼ同額' }]} unit="万円" />
//   highlight に label を渡すと、その棒だけブランド色（省略時は全部ブランド色）
//   負の値も可：0 の位置に軸を引き、負の棒は注意色（--warn）。signed で値に +/− を付ける
interface Item {
	label: string;
	value: number;
	note?: string;
}
interface Props {
	data: Item[];
	unit?: string;
	highlight?: string;
	title?: string;
	signed?: boolean;
}
const { data, unit = '', highlight, title, signed = false } = Astro.props;
const max = Math.max(...data.map((d) => d.value), 0);
const min = Math.min(...data.map((d) => d.value), 0);
const span = max - min || 1;
const labelW = Math.min(230, Math.max(...data.map((d) => [...d.label].length)) * 15 + 10);
const W = 640;
const barX = labelW + 10;
const barMax = W - barX - 120;
const rowH = data.some((d) => d.note) ? 50 : 38;
const H = data.length * rowH + 6;
const x0 = barX + (-min / span) * barMax;
const fmt = (v: number) =>
	(signed && v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toLocaleString('ja-JP');
const aria = title ?? data.map((d) => `${d.label} ${fmt(d.value)}${unit}`).join('、');
---

<div class="barchart">
	{title && <p class="bc-title">{title}</p>}
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={aria}>
		{
			data.map((d, i) => {
				const y = i * rowH + 4;
				const w = Math.max(2, (Math.abs(d.value) / span) * barMax);
				const neg = d.value < 0;
				const bx = neg ? x0 - w : x0;
				const on = !highlight || highlight === d.label;
				return (
					<g>
						<text x={labelW} y={y + 19} text-anchor="end" class="lbl">
							{d.label}
						</text>
						<rect x={bx} y={y + 3} width={w} height={22} rx={3} class={neg ? 'bar neg' : on ? 'bar on' : 'bar'} />
						<text x={neg ? x0 + 8 : x0 + w + 8} y={y + 19} class="val">
							{fmt(d.value) + unit}
						</text>
						{d.note && (
							<text x={barX} y={y + 42} class="note">
								{d.note}
							</text>
						)}
					</g>
				);
			})
		}
		{min < 0 && <line x1={x0} x2={x0} y1={0} y2={H} class="axis" />}
	</svg>
</div>

<style>
	.barchart {
		margin: 0.5rem 0;
	}
	.bc-title {
		font-weight: 700;
		font-size: 0.95rem;
		margin: 0 0 0.5rem !important;
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
		font-family: inherit;
	}
	.lbl {
		font-size: 14px;
		fill: var(--text);
	}
	.val {
		font-size: 14px;
		font-weight: 700;
		fill: var(--text);
	}
	.note {
		font-size: 12px;
		fill: var(--muted);
	}
	.bar {
		fill: var(--muted);
		opacity: 0.4;
	}
	.bar.neg {
		fill: var(--warn);
		opacity: 1;
	}
	.axis {
		stroke: var(--muted);
		stroke-width: 1;
	}
	.bar.on {
		fill: var(--accent);
		opacity: 1;
	}
</style>
