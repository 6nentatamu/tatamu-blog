---
// 記事一覧（文字だけのリスト）
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
	posts: CollectionEntry<'posts'>[];
	cols?: 2 | 3;
}
const { posts, cols = 2 } = Astro.props;
---

{posts.length === 0 && <p class="empty">まだ記事はありません。</p>}
<div class:list={['grid', `c${cols}`]}>
	{posts.map((p) => <PostCard post={p} compact={cols === 3} />)}
</div>

<style>
	.grid {
		border-top: 1px solid var(--line);
	}
	.empty {
		color: var(--muted);
	}
</style>
