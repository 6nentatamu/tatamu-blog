---
// 記事末尾の「連載の前後」リンク。同じ部の中を order 順にたどる。
import type { CollectionEntry } from 'astro:content';
import { categoryOf } from '../data/categories';

interface Props {
	prev?: CollectionEntry<'posts'>;
	next?: CollectionEntry<'posts'>;
	category: CollectionEntry<'posts'>['data']['category'];
}
const { prev, next, category } = Astro.props;
const cat = categoryOf(category);
---

<nav class="series-nav" aria-label="連載の前後">
	<p class="label">連載「{cat.name}」</p>
	<div class="links">
		{prev ? <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a> : <span />}
		{next ? <a href={`/posts/${next.id}/`}>{next.data.title} →</a> : <span />}
	</div>
	<p class="all"><a href="/series/">連載目次を見る</a></p>
</nav>

<style>
	.series-nav {
		margin-top: 3rem;
		padding: 1rem;
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.label {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.all {
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
	}
</style>
