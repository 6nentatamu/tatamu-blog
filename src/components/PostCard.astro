---
// 記事カード（部の名前・タイトル・読了時間）。2026-10-21 会議：画像内にもタイトルがあり2回読ませるため、一覧は文字だけ
import type { CollectionEntry } from 'astro:content';
import { partLabel } from '../data/categories';
import { readingMinutes } from '../lib/posts';

interface Props {
	post: CollectionEntry<'posts'>;
	compact?: boolean;
}
const { post, compact = false } = Astro.props;
---

<article class:list={['card', { compact }]} style={`--cat: var(--c-${post.data.category})`}>
	<div class="body">
		<p class="part">{partLabel(post.data.category)}</p>
		<h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
		<p class="meta">
			<span>{readingMinutes(post)}分で読めます</span>
		</p>
	</div>
</article>

<style>
	.card {
		border-bottom: 1px solid var(--line);
	}
	.body {
		padding: 1rem 0;
	}
	.card .part {
		margin: 0 0 0.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--cat, var(--accent));
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.part::before {
		content: '';
		width: 14px;
		height: 3px;
		border-radius: 2px;
		background: var(--cat, var(--accent));
	}
	.card h3 {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.6;
		margin: 0 0 0.3rem;
		/* 一覧を .prose の中に置くので、本文用の h3（左線・余白）を打ち消す */
		padding: 0;
		border: 0;
		background: none;
		margin-top: 0;
	}
	h3 a {
		color: var(--text);
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--link);
		text-decoration: underline;
	}
	.card .meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.compact h3 {
		font-size: 0.95rem;
	}
</style>
