---
// 記事カード（アイキャッチ・部の名前・タイトル・読了時間）
import type { CollectionEntry } from 'astro:content';
import { partLabel } from '../data/categories';
import { ogPath, readingMinutes } from '../lib/posts';

interface Props {
	post: CollectionEntry<'posts'>;
	compact?: boolean;
}
const { post, compact = false } = Astro.props;
---

<article class:list={['card', { compact }]} style={`--cat: var(--c-${post.data.category})`}>
	<a href={`/posts/${post.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
		<img src={ogPath(post)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
	</a>
	<div class="body">
		<p class="part">{partLabel(post.data.category)}</p>
		<h3><a href={`/posts/${post.id}/`}>{post.data.title}</a></h3>
		<p class="meta">
			<span>{readingMinutes(post)}分で読めます</span>
		</p>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: transparent;
	}
	.thumb img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 1200 / 630;
		border-radius: 6px;
		outline: 1px solid var(--line);
		outline-offset: -1px;
	}
	.body {
		padding: 0.75rem 0 0.25rem;
	}
	.part {
		margin: 0 0 0.25rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--cat, var(--accent));
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.part::before {
		content: '';
		width: 14px;
		height: 3px;
		border-radius: 2px;
		background: var(--cat, var(--accent));
	}
	h3 {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.6;
		margin: 0 0 0.4rem;
	}
	h3 a {
		color: var(--text);
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--link);
		text-decoration: underline;
	}
	.meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.compact h3 {
		font-size: 0.95rem;
	}
</style>
