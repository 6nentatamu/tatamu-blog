---
// トップの図：6年の目盛りと「今どこにいるか」。current は今の年目（1〜6）
interface Props {
	current?: number;
}
const { current = 1 } = Astro.props;
const years = [1, 2, 3, 4, 5, 6];
---

<figure class="scale" aria-label={`6年の目盛り。今は${current}年目`}>
	<p class="scale-head">
		<span>設立</span>
		<strong>6年で解散</strong>
	</p>
	<ol class="bars">
		{
			years.map((y) => (
				<li class:list={[{ done: y < current, now: y === current }]}>
					{y === current && <span class="here">今ここ</span>}
					<span class="bar" />
					<span class="yl">{y}年目</span>
				</li>
			))
		}
	</ol>
	<figcaption>設立から解散まで6年。今は{current}年目です</figcaption>
</figure>

<style>
	.scale {
		margin: 0;
		padding: 1.1rem 1.1rem 0.9rem;
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: 12px;
		box-shadow: 0 6px 20px rgb(0 0 0 / 0.06);
	}
	.scale-head {
		display: flex;
		justify-content: space-between;
		margin: 0 0 0.4rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.scale-head strong {
		color: var(--text);
	}
	.bars {
		list-style: none;
		margin: 0;
		padding: 1.9rem 0 0;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.45rem;
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.bar {
		display: block;
		width: 100%;
		height: 64px;
		border: 2px solid var(--muted);
		opacity: 0.45;
		border-radius: 3px;
	}
	.done .bar {
		background: var(--text);
		border-color: var(--text);
		opacity: 1;
	}
	.now .bar {
		background: var(--accent);
		border-color: var(--accent);
		opacity: 1;
	}
	.yl {
		margin-top: 0.3rem;
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.now .yl {
		color: var(--accent);
		font-weight: 700;
	}
	.here {
		position: absolute;
		top: -1.85rem;
		white-space: nowrap;
		font-size: 0.75rem;
		font-weight: 700;
		color: #fff;
		background: var(--accent);
		border-radius: 999px;
		padding: 0.05rem 0.55rem;
	}
	.here::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -5px;
		margin-left: -5px;
		border: 5px solid transparent;
		border-bottom: 0;
		border-top-color: var(--accent);
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: 0.85rem;
		text-align: center;
		color: var(--text);
	}
</style>
