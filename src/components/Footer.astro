---
import { AUTHOR, X_URL } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<nav aria-label="サイト情報">
		<a href="/author/">運営者情報</a>
		<a href="/contact/">お問い合わせ</a>
		<a href="/privacy/">プライバシーポリシー</a>
		<a href="/disclaimer/">PR表記・免責</a>
		{X_URL && <a href={X_URL} rel="me noopener" target="_blank">X</a>}
	</nav>
	<p>&copy; {year} {AUTHOR}</p>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding: 2rem 1rem 3rem;
		/* 深緑の帯（ライト・ダーク共通の固定色） */
		border-top: 4px solid var(--deadline);
		background: #0a4438;
		color: #d9e8e2;
		font-size: 0.875rem;
		text-align: center;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.25rem;
		margin-bottom: 1rem;
	}
	a {
		color: #fff6e9;
	}
</style>
