---
// 記事末の「出典・制度の時点」欄

interface Props {
	sources?: { title: string; url: string }[];
	asOf?: string;
	updatedDate?: Date;
}
const { sources = [], asOf, updatedDate } = Astro.props;
const show = sources.length > 0 || asOf || updatedDate;
---

{
	show && (
		<section class="sources" aria-label="出典・制度の時点">
			<p class="s-title">出典・制度の時点</p>
			{(asOf || updatedDate) && (
				<p class="asof">
					{asOf}
					{updatedDate && (
						<span>
							{asOf && '・'}最終更新 {updatedDate.getFullYear()}年{updatedDate.getMonth() + 1}月
						</span>
					)}
				</p>
			)}
			{sources.length > 0 && (
				<ul>
					{sources.map((s) => (
						<li>
							<a href={s.url} rel="noopener" target="_blank">
								{s.title}
							</a>
						</li>
					))}
				</ul>
			)}
		</section>
	)
}

<style>
	.sources {
		margin-top: 2rem;
		padding: 0.9rem 1.1rem;
		background: var(--subtle);
		border-radius: 8px;
		font-size: 0.88rem;
	}
	.s-title {
		margin: 0 0 0.3rem;
		font-weight: 700;
	}
	.asof {
		margin: 0 0 0.4rem;
		color: var(--muted);
	}
	ul {
		margin: 0;
		padding-left: 1.2rem;
	}
</style>
