---
// 「この記事の数字」。frontmatter の keyNumbers（最大3つ）を集計表（罫線の帳面）の形で出す
interface Props {
	items: { label: string; value: string; note?: string }[];
}
const { items } = Astro.props;
---

<section class="keynums" aria-label="この記事の数字">
	<p class="kn-title">この記事の数字</p>
	<dl class="ledger">
		{
			items.map((k) => (
				<div class="kn">
					<dt>
						{k.label}
						{k.note && <span class="note">{k.note}</span>}
					</dt>
					<dd class="v">{k.value}</dd>
				</div>
			))
		}
	</dl>
</section>

<style>
	.keynums {
		margin: 0 0 1.75rem;
	}
	.kn-title {
		margin: 0 0 0.3rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--muted);
	}
	/* 数字カード：白地に細枠、左に太い深緑線。数字だけ大きい明朝。結論（ベタ）・表（面）と見分ける */
	.ledger {
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 0.75rem;
	}
	.kn {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.35rem;
		padding: 0.8rem 1rem 0.85rem;
		border: 1px solid var(--line);
		border-left: 4px solid var(--accent);
		border-radius: 8px;
		background: var(--bg);
	}
	dt {
		min-width: 0;
		font-size: 0.85rem;
		line-height: 1.5;
	}
	.note {
		display: block;
		font-size: 0.78rem;
		color: var(--muted);
	}
	dd {
		margin: 0;
	}
	.v {
		max-width: 100%;
		font-family: var(--mincho);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--accent-strong);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 420px) {
		.v {
			font-size: 1.45rem;
		}
	}
</style>
