---
// 「この記事の数字」。frontmatter の keyNumbers（最大3つ）を集計表（罫線の帳面）の形で出す
interface Props {
	items: { label: string; value: string; note?: string }[];
}
const { items } = Astro.props;
---

<section class="keynums" aria-label="この記事の数字">
	<p class="kn-title">この記事の数字</p>
	<dl class="ledger">
		{
			items.map((k) => (
				<div class="kn">
					<dt>
						{k.label}
						{k.note && <span class="note">{k.note}</span>}
					</dt>
					<dd class="v">{k.value}</dd>
				</div>
			))
		}
	</dl>
</section>

<style>
	.keynums {
		margin: 0 0 1.75rem;
	}
	.kn-title {
		margin: 0 0 0.3rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--muted);
	}
	.ledger {
		margin: 0;
		background: var(--card);
		border-top: 2px solid var(--accent);
	}
	/* 1行＝項目｜数字。狭いときは数字が次の行に落ちる（はみ出さない） */
	.kn {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0 1rem;
		padding: 0.5rem 0.6rem 0.5rem 0.9rem;
		border-bottom: 1px solid var(--rule);
		border-left: 3px double var(--deadline);
	}
	dt {
		flex: 1 1 9em;
		min-width: 0;
		font-size: 0.9rem;
		line-height: 1.5;
	}
	.note {
		display: block;
		font-size: 0.78rem;
		color: var(--muted);
	}
	dd {
		margin: 0;
	}
	.v {
		margin-left: auto;
		max-width: 100%;
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.4;
		color: var(--accent-strong);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 420px) {
		.v {
			font-size: 1.3rem;
		}
	}
</style>
