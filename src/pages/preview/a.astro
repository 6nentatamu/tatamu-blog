---
import EntryCards from '../../components/EntryCards.astro';
import PostList from '../../components/PostList.astro';
import ProfileBox from '../../components/ProfileBox.astro';
import { CURRENT_YEAR, SITE_DESCRIPTION, SITE_TITLE, TOTAL_YEARS } from '../../consts';
import Base from '../../layouts/Base.astro';
import { entries, facts, lead } from './_data';
import { load } from './_common';
const { latest, parts } = await load();
const years = Array.from({ length: TOTAL_YEARS }, (_, i) => i + 1);
---
<Base title={`案A ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<meta slot="head" name="robots" content="noindex" />
	<section class="dark">
		<div class="in">
			<p class="eyebrow"><span>特集</span>ひとり法人の設立から解散までの記録</p>
			<h1>解散日まで決めて、<br />ひとり法人を<br class="sp" />作りました。</h1>
			<p class="lead">{lead}</p>
			<ul class="facts">
				{facts.map((f) => (
					<li><a href={f.href}><span class="fv">{f.value}</span><span class="fl">{f.label}</span></a></li>
				))}
			</ul>
			<div class="cta">
				<a class="start" href="/hajimeni/">はじめに読む →</a>
				<a class="sub" href="/series/">連載目次</a>
			</div>
		</div>
		<div class="gauge" aria-label={`${TOTAL_YEARS}年のうち${CURRENT_YEAR}年目`}>
			<p class="gh"><span>{TOTAL_YEARS}年のうち</span><strong>{CURRENT_YEAR}</strong><span>年目</span><em>残り{TOTAL_YEARS - CURRENT_YEAR}年</em></p>
			<ol>
				{years.map((y) => (
					<li class:list={[{ done: y < CURRENT_YEAR, now: y === CURRENT_YEAR }]}><span>{y}</span></li>
				))}
			</ol>
			<p class="gl"><span>設立</span><span>解散</span></p>
		</div>
	</section>
	<main class="container wide">
		<section class="entry"><EntryCards items={entries} /></section>
		<section>
			<h2 class="sec"><span>Latest</span>新着記事</h2>
			<PostList posts={latest} cols={3} />
		</section>
		<section>
			<h2 class="sec"><span>Series</span>連載</h2>
			<ol class="parts">
				{parts.map((c, i) => (
					<li><a href={`/series/#part-${i}`}><span class="no">第{i}部</span><span class="name">{c.name}</span></a><p>{c.lead}</p></li>
				))}
			</ol>
			<p><a href="/series/">連載目次（全記事）→</a></p>
		</section>
		<section class="about"><ProfileBox label="書いている人" /></section>
	</main>
</Base>
<style>
	.dark { background: linear-gradient(160deg, #0f1a24 0%, #16181c 70%); color: #ece6da; overflow: hidden; }
	.in { max-width: var(--wide); margin: 0 auto; padding: 3rem 1rem 1.5rem; }
	.eyebrow { font-size: .85rem; letter-spacing: .1em; color: #9fb9b4; margin: 0 0 1.2rem; display: flex; gap: .7rem; align-items: center; flex-wrap: wrap; }
	.eyebrow span { border: 1px solid #c8553d; color: #e07a62; padding: .1rem .55rem; }
	h1 { font-family: var(--mincho); font-weight: 700; font-size: clamp(2rem, 7.4vw, 5rem); line-height: 1.25; margin: 0 0 1.5rem; letter-spacing: .02em; border-top: 3px double #ece6da55; padding-top: 1.2rem; }
	.sp { display: none; }
	@media (max-width: 520px) { .sp { display: inline; } }
	.lead { max-width: 38em; color: #cfc8ba; margin: 0 0 2rem; }
	.facts { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 0; grid-template-columns: 1fr; border-top: 1px solid #ffffff22; }
	@media (min-width: 760px) { .facts { grid-template-columns: repeat(3, 1fr); } .facts li + li { border-left: 1px solid #ffffff22; } }
	.facts li { border-bottom: 1px solid #ffffff22; }
	.facts a { display: block; padding: 1rem .9rem; color: inherit; text-decoration: none; }
	.fv { display: block; font-family: var(--mincho); font-variant-numeric: tabular-nums; font-size: clamp(1.8rem, 4.6vw, 3rem); font-weight: 700; line-height: 1.15; color: #fff; }
	.fl { font-size: .85rem; color: #9fb9b4; }
	.cta { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
	.start { background: #ece6da; color: #111; padding: .8rem 1.7rem; font-weight: 700; text-decoration: none; }
	.sub { color: #ece6da; font-weight: 700; }
	.gauge { padding: 1.5rem 0 2rem; }
	.gh { max-width: var(--wide); margin: 0 auto .6rem; padding: 0 1rem; display: flex; align-items: baseline; gap: .4rem; flex-wrap: wrap; }
	.gh strong { font-family: var(--mincho); font-size: clamp(3.5rem, 12vw, 7rem); line-height: 1; color: #e07a62; font-variant-numeric: tabular-nums; }
	.gh em { margin-left: auto; font-style: normal; color: #9fb9b4; }
	.gauge ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
	.gauge li { height: clamp(56px, 10vw, 120px); background: transparent; border: 1px solid #ffffff33; display: flex; align-items: flex-end; padding: .4rem .6rem; font-family: var(--mincho); font-size: clamp(1rem, 3vw, 2rem); color: #ffffff66; }
	.gauge li.done { background: #3a4651; }
	.gauge li.now { background: #c8553d; border-color: #c8553d; color: #fff; }
	.gl { display: flex; justify-content: space-between; padding: .4rem 1rem 0; font-size: .8rem; color: #9fb9b4; margin: 0; }
	.wide { max-width: var(--wide); }
	main section { margin-top: 3rem; }
	.entry { margin-top: 2rem; }
	.sec { font-family: var(--mincho); font-size: clamp(1.6rem, 4vw, 2.4rem); border-bottom: 2px solid var(--text); padding-bottom: .3rem; margin: 0 0 1.2rem; }
	.sec span { display: block; font-family: system-ui; font-size: .75rem; letter-spacing: .2em; color: var(--accent); text-transform: uppercase; }
	.parts { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 0; }
	@media (min-width: 720px) { .parts { grid-template-columns: repeat(3, 1fr); } }
	.parts li { border-top: 1px solid var(--line); padding: 1rem .5rem 1rem 0; }
	.parts a { text-decoration: none; color: var(--text); font-family: var(--mincho); font-size: 1.15rem; font-weight: 700; }
	.no { display: block; color: var(--accent); font-size: .85rem; }
	.parts p { margin: .3rem 0 0; font-size: .875rem; color: var(--muted); }
	.about { max-width: 560px; }
</style>
