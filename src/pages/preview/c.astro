---
import EntryCards from '../../components/EntryCards.astro';
import PostList from '../../components/PostList.astro';
import ProfileBox from '../../components/ProfileBox.astro';
import { CURRENT_YEAR, SITE_DESCRIPTION, SITE_TITLE, TOTAL_YEARS } from '../../consts';
import Base from '../../layouts/Base.astro';
import { entries, facts, lead } from './_data';
import { load } from './_common';
const { latest, parts } = await load();
const years = Array.from({ length: TOTAL_YEARS }, (_, i) => i + 1);
---
<Base title={`案C ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<meta slot="head" name="robots" content="noindex" />
	<div class="grid-bg">
		<section class="in hero">
			<div class="page">
				<svg class="stamp s1" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" fill="none" stroke="#1f6f6a" stroke-width="5" /><circle cx="60" cy="60" r="43" fill="none" stroke="#1f6f6a" stroke-width="1.5" /><text x="60" y="72" text-anchor="middle" font-size="34" font-weight="700" fill="#1f6f6a" font-family="serif">設立</text></svg>
				<p class="eyebrow">ひとり法人の設立から解散までの記録</p>
				<h1>解散日まで決めて、<br />ひとり法人を作りました。</h1>
				<p class="lead">{lead}</p>
				<table class="ledger">
					<caption>集計（記事の実数）</caption>
					<tbody>
						{facts.map((f) => (
							<tr><th scope="row"><a href={f.href}>{f.label}</a></th><td>{f.value}</td></tr>
						))}
					</tbody>
				</table>
				<div class="cta">
					<a class="start" href="/hajimeni/">はじめに読む →</a>
					<a class="sub" href="/series/">連載目次</a>
				</div>
			</div>
			<div class="note">
				<span class="tape" aria-hidden="true" />
				<p class="nh">年表　<b>{TOTAL_YEARS}年のうち{CURRENT_YEAR}年目</b></p>
				<ol class="tl">
					{years.map((y) => (
						<li class:list={[{ done: y < CURRENT_YEAR, now: y === CURRENT_YEAR }]}>
							<span class="y">{y}年目</span>
							<span class="row">{y === 1 ? '設立・届出・口座' : y === TOTAL_YEARS ? '解散・清算' : '運営'}</span>
							{y === CURRENT_YEAR && <span class="here">いまここ</span>}
						</li>
					))}
				</ol>
				<svg class="stamp s2" viewBox="0 0 140 70" aria-hidden="true"><rect x="4" y="4" width="132" height="62" rx="6" fill="none" stroke="#c8553d" stroke-width="4" /><text x="70" y="45" text-anchor="middle" font-size="24" font-weight="700" fill="#c8553d" font-family="serif">解散予定</text></svg>
			</div>
		</section>
	</div>
	<main class="in body">
		<section class="sticky-wrap"><EntryCards items={entries} /></section>
		<section>
			<h2 class="sec">新着記事</h2>
			<PostList posts={latest} cols={3} />
		</section>
		<section>
			<h2 class="sec">連載</h2>
			<ol class="parts">
				{parts.map((c, i) => (
					<li style={`--r:${(i % 2 ? 1 : -1) * 0.8}deg`}>
						<a href={`/series/#part-${i}`}><span class="no">第{i}部</span><span class="name">{c.name}</span></a>
						<p>{c.lead}</p>
					</li>
				))}
			</ol>
			<p><a href="/series/">連載目次（全記事）→</a></p>
		</section>
		<section class="about"><ProfileBox label="書いている人" /></section>
	</main>
</Base>
<style>
	.grid-bg { background-color: #f6f3ec; background-image: linear-gradient(#1f6f6a14 1px, transparent 1px), linear-gradient(90deg, #1f6f6a14 1px, transparent 1px); background-size: 20px 20px; border-bottom: 1px solid var(--line); overflow: hidden; }
	.in { max-width: var(--wide); margin: 0 auto; padding: 0 1rem; }
	.hero { display: grid; gap: 2rem; padding-top: 2.5rem; padding-bottom: 3rem; }
	@media (min-width: 860px) { .hero { grid-template-columns: 1.15fr 1fr; align-items: start; } }
	.page { position: relative; color: #26231f; }
	.stamp { position: absolute; }
	.s1 { width: 84px; right: 0; top: -.5rem; transform: rotate(12deg); opacity: .8; }
	.eyebrow { font-weight: 700; color: #1f6f6a; font-size: .85rem; margin: 0 0 .6rem; padding-right: 90px; }
	h1 { font-family: var(--mincho); font-size: clamp(1.7rem, 5.6vw, 2.8rem); line-height: 1.4; margin: 0 0 1rem; }
	.lead { margin: 0 0 1.4rem; }
	.ledger { width: 100%; border-collapse: collapse; background: #fffdf9; margin-bottom: 1.4rem; box-shadow: 0 1px 0 #e4dfd5; }
	.ledger caption { text-align: left; font-size: .8rem; color: #6b655c; padding-bottom: .3rem; }
	.ledger th, .ledger td { border-bottom: 1px solid #b9cfcb; padding: .55rem .6rem; }
	.ledger tr:first-child th, .ledger tr:first-child td { border-top: 2px solid #1f6f6a; }
	.ledger th { text-align: left; font-weight: 400; font-size: .9rem; border-right: 1px solid #c8553d66; }
	.ledger th a { color: #26231f; }
	.ledger td { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; font-size: 1.15rem; color: #17534f; white-space: nowrap; }
	.cta { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
	.start { background: #1f6f6a; color: #fff; padding: .7rem 1.5rem; border-radius: 4px; font-weight: 700; text-decoration: none; }
	.sub { font-weight: 700; color: #1f6f6a; }
	.note { position: relative; background: #fffdf9; color: #26231f; padding: 1.6rem 1.2rem 1.2rem 2.6rem; box-shadow: 0 2px 10px #0000001a; background-image: repeating-linear-gradient(#fffdf9 0 31px, #cfdcd9 31px 32px); border-left: 2px solid #c8553d55; transform: rotate(.6deg); }
	.tape { position: absolute; top: -12px; left: 40%; width: 90px; height: 24px; background: #c8553d33; transform: rotate(-4deg); }
	.nh { margin: 0 0 .5rem; line-height: 32px; font-size: .9rem; color: #6b655c; }
	.nh b { color: #26231f; }
	.tl { list-style: none; margin: 0; padding: 0; }
	.tl li { display: flex; gap: .8rem; align-items: center; line-height: 32px; height: 32px; }
	.y { width: 3.5em; font-weight: 700; font-variant-numeric: tabular-nums; color: #6b655c; }
	.row { color: #9a9387; font-size: .9rem; }
	.tl li.done .y { color: #26231f; }
	.tl li.now .y { color: #c8553d; }
	.tl li.now .row { color: #26231f; font-weight: 700; }
	.here { background: #f7e6e0; color: #c8553d; font-size: .75rem; font-weight: 700; padding: 0 .5rem; line-height: 1.6; border-radius: 3px; }
	.s2 { width: 120px; right: .8rem; bottom: 1.4rem; transform: rotate(-8deg); opacity: .85; }
	.body section { margin-top: 2.5rem; }
	.sticky-wrap { margin-top: 2rem; }
	.sec { font-size: 1.25rem; margin: 0 0 1rem; display: inline-block; background: linear-gradient(transparent 60%, #e6efec 60%); padding: 0 .3rem; }
	.parts { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 1rem; }
	@media (min-width: 720px) { .parts { grid-template-columns: repeat(3, 1fr); } }
	.parts li { background: #fbf3d4; color: #26231f; padding: 1rem; box-shadow: 0 3px 6px #0000001f; transform: rotate(var(--r)); }
	.parts li:nth-child(3n+2) { background: #e6efec; }
	.parts li:nth-child(3n) { background: #f7e6e0; }
	.parts a { text-decoration: none; color: #26231f; font-weight: 700; }
	.no { color: #1f6f6a; margin-right: .5rem; font-size: .85rem; }
	.parts p { margin: .3rem 0 0; font-size: .875rem; color: #6b655c; }
	.about { max-width: 560px; }
</style>
