---
import EntryCards from '../components/EntryCards.astro';
import PostList from '../components/PostList.astro';
import ProfileBox from '../components/ProfileBox.astro';
import SixYearScale from '../components/SixYearScale.astro';
import { CURRENT_YEAR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CATEGORIES } from '../data/categories';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
// 新着は法人の本編・月次だけ。前日譚は入口側に置き、新着を埋めない
const latest = posts.filter((p) => p.data.category !== 'prequel').slice(0, 6);
const parts = CATEGORIES.filter((c) => c.id !== 'monthly');

// 最初の画面に出す実数（サイト内記事の数字）
const facts = [
	{ value: '年約14.4万円', label: 'FIREより法人が得だった差', href: '/posts/prequel-5-hojin/' },
	{ value: '68,590円', label: '設立費用の実額', href: '/posts/monthly-y1-01/' },
];

const entries = [
	{
		kicker: '休職・退職を考えている方へ',
		title: '適応障害で休職し、辞めるまで',
		text: '休職の手続き、退職の判断、健康保険とハローワーク。体調が悪い中でやったことを順に書いています。',
		links: [
			{ href: '/posts/prequel-1-kyushoku/', label: '前日譚の1話目から読む' },
			{ href: '/series/#part-0', label: '第0部 前日譚の目次' },
		],
	},
	{
		kicker: 'FIREか法人化かで迷っている方へ',
		title: '働かずに暮らすなら、法人は得か',
		text: '国保・年金・税を個人のままと法人で比べ、6年でたたむ法人に決めました。設計の中身も実数で書いています。',
		links: [
			{ href: '/posts/prequel-5-hojin/', label: 'マイクロ法人にした理由' },
			{ href: '/series/#part-1', label: '第1部 構想' },
			{ href: '/series/#part-2', label: '第2部 設計' },
		],
	},
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-inner">
			<div class="hero-text">
				<p class="eyebrow">ひとり法人の設立から解散までの記録</p>
				<h1>解散日まで決めて、<br />ひとり法人を作りました。</h1>
				<p class="lead">
					適応障害で会社員を辞めたあと、6年でたたむと決めて法人を作りました。設立費用・役員報酬・社会保険・解散の税務を、実際の数字で書いています。
				</p>
				<ul class="facts">
					{
						facts.map((f) => (
							<li>
								<a href={f.href}>
									<span class="fv">{f.value}</span>
									<span class="fl">{f.label}</span>
								</a>
							</li>
						))
					}
				</ul>
				<div class="cta">
					<a class="start" href="/hajimeni/">はじめに読む →</a>
					<a class="sub" href="/series/">連載目次</a>
				</div>
			</div>
			<div class="hero-fig">
				<SixYearScale current={CURRENT_YEAR} />
			</div>
		</div>
	</section>

	<main class="container wide">
		<section class="entry-sec" aria-label="入口">
			<EntryCards items={entries} />
		</section>

		<section>
			<h2 class="sec">新着記事</h2>
			<PostList posts={latest} cols={3} />
		</section>

		<section>
			<h2 class="sec">連載</h2>
			<ol class="parts">
				{
					parts.map((c, i) => (
						<li>
							<a href={`/series/#part-${i}`}>
								<span class="no">第{i}部</span>
								<span class="name">{c.name}</span>
							</a>
							<p>{c.lead}</p>
						</li>
					))
				}
			</ol>
			<p><a href="/series/">連載目次（全記事）→</a></p>
		</section>

		<section class="about">
			<ProfileBox label="書いている人" />
		</section>
	</main>
</Base>

<style>
	.hero {
		background: var(--page);
		border-bottom: 1px solid var(--line);
	}
	.hero-inner {
		max-width: var(--wide);
		margin: 0 auto;
		padding: 1.75rem 1rem 2rem;
		display: grid;
		gap: 1.5rem;
		align-items: center;
	}
	@media (min-width: 860px) {
		.hero-inner {
			grid-template-columns: 1.1fr 1fr;
			gap: 3rem;
			padding: 3rem 1rem 3.25rem;
		}
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
	}
	h1 {
		font-size: clamp(1.45rem, 5.4vw, 2.1rem);
		line-height: 1.45;
		margin: 0 0 0.75rem;
	}
	.lead {
		margin: 0 0 1.25rem;
		font-size: 1rem;
		color: var(--text);
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}
	.start {
		display: inline-block;
		padding: 0.7rem 1.5rem;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		font-weight: 700;
		text-decoration: none;
		
	}
	.start:hover {
		background: var(--accent-strong);
	}
	.sub {
		font-weight: 700;
	}
	.facts {
		list-style: none;
		margin: 0 0 1.25rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.facts a {
		display: flex;
		flex-direction: column;
		padding: 0.45rem 0.9rem;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 8px;
		text-decoration: none;
		color: var(--text);
	}
	.fv {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--accent-strong);
		line-height: 1.35;
	}
	.fl {
		font-size: 0.78rem;
		color: var(--muted);
	}
	.entry-sec {
		margin-top: 1.75rem;
	}
	.wide {
		max-width: var(--wide);
	}
	main section {
		margin-top: 2.5rem;
	}
	.sec {
		font-size: 1.25rem;
		margin: 0 0 1rem;
		padding-left: 0.7rem;
		border-left: 6px solid var(--accent);
	}
	.parts {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: grid;
		gap: 0.75rem;
	}
	@media (min-width: 720px) {
		.parts {
			grid-template-columns: 1fr 1fr 1fr;
		}
	}
	.parts li {
		border: 1px solid var(--line);
		border-top: 3px solid var(--accent);
		border-radius: 8px;
		padding: 0.9rem 1rem;
		background: var(--card);
	}
	.parts a {
		text-decoration: none;
		color: var(--text);
		font-weight: 700;
	}
	.parts .no {
		color: var(--accent);
		margin-right: 0.5rem;
		font-size: 0.85rem;
	}
	.parts p {
		margin: 0.3rem 0 0;
		font-size: 0.875rem;
		color: var(--muted);
	}
	.about {
		max-width: 560px;
	}
</style>
