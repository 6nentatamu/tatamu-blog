---
import { render } from 'astro:content';
import AffBanner from '../../components/AffBanner.astro';
import AffLink from '../../components/AffLink.astro';
import BarChart from '../../components/BarChart.astro';
import Caution from '../../components/Caution.astro';
import Figure from '../../components/Figure.astro';
import Steps from '../../components/Steps.astro';
import Memo from '../../components/Memo.astro';
import Point from '../../components/Point.astro';
import Post from '../../layouts/Post.astro';
import { getPosts, relatedPosts, seriesOrder } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => {
		const series = seriesOrder(posts, post.data.category);
		const i = series.findIndex((p) => p.id === post.id);
		return {
			params: { slug: post.id },
			props: { post, prev: series[i - 1], next: series[i + 1], related: relatedPosts(posts, post) },
		};
	});
}

const { post, prev, next, related } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} prev={prev} next={next} headings={headings} related={related}>
	<Content components={{ AffLink, AffBanner, Point, Caution, Memo, Figure, BarChart, Steps }} />
</Post>
